# StaySoul Backend - Environment Variables
# Copy this file to your deployment environment (Render / Railway / local)

# ===== Database =====
DB_URL=jdbc:postgresql://localhost:5432/StaySoul
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# ===== JWT =====
JWT_SECRET_KEY=YourSuperSecretKeyAtLeast32CharactersLong!

# ===== Frontend (CORS) =====
FRONTEND_URL=http://localhost:5173

# ===== Stripe =====
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ===== Google OAuth2 =====
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ===== Email (Gmail SMTP) =====
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# ===== Optional: Debug =====
# DDL_AUTO=update
# SHOW_SQL=false
# LOG_SQL=WARN
